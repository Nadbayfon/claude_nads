NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...        # only used in /api/cron/* and /api/(whatsapp|email|calendar)/inbound

ANTHROPIC_API_KEY=...

# Inbound webhooks (Phase 4 / Phase 6)
WHATSAPP_APP_SECRET=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_TOKEN=...
RESEND_INBOUND_SECRET=...

# Per-planner OAuth
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
M365_OAUTH_CLIENT_ID=...
M365_OAUTH_CLIENT_SECRET=...

# Where to find prompt files at runtime (defaults to ./prompts).
CRYSTAL_PROMPTS_DIR=../../prompts
